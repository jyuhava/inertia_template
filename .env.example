APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=5400
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Atria AI (fitur tanya materi & generate draft materi)
ATRIA_API_KEY=
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL=Atria-Dawn-Preview
ATRIA_TIMEOUT=280

# Integrator PDDikti / Neo Feeder. Keep secrets server-side; never prefix them with VITE_.
INTEGRATOR_ENABLED=true
INTEGRATOR_ALLOW_WRITE=false
# Empty by default; explicitly list acts only after field-level verification.
INTEGRATOR_VERIFIED_WRITE_ACTS=
INTEGRATOR_MAX_ITEMS_PER_JOB=500
INTEGRATOR_SYNC_MODE=sync
INTEGRATOR_SYNC_QUEUE=default
NEOFEEDER_BASE_URL=
NEOFEEDER_WS_URL=
NEOFEEDER_USERNAME=
NEOFEEDER_PASSWORD=
NEOFEEDER_VERSION=3.0
NEOFEEDER_SANDBOX=false
NEOFEEDER_TIMEOUT=30
NEOFEEDER_RETRY=2
NEOFEEDER_RETRY_DELAY=500
NEOFEEDER_PROXY=
NEOFEEDER_USE_PROXY=false
NEOFEEDER_TOKEN_TTL=82800

# Optional institution profile for the read-only perguruan-tinggi entity.
INSTITUSI_KODE_PT=
INSTITUSI_NAMA_PT=
INSTITUSI_SINGKATAN=
INSTITUSI_ALAMAT=
INSTITUSI_TELEPON=
INSTITUSI_EMAIL=
INSTITUSI_WEBSITE=
INSTITUSI_NPWP=
INSTITUSI_AKREDITASI=

# Origin yang boleh memanggil API (pisahkan koma). Wajib spesifik,
# bukan "*", karena memakai cookie sesi Sanctum.
SIAKAD_CORS_ORIGINS=https://feeder.alwafi.ac.id,https://siakad.alwafi.ac.id,https://sia.alwafi.ac.id
SANCTUM_STATEFUL_DOMAINS=feeder.alwafi.ac.id,siakad.alwafi.ac.id,sia.alwafi.ac.id,localhost,127.0.0.1
