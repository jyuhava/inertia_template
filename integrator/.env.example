# ---------------------------------------------------------------------------
# Integrator PDDikti / Neo Feeder — contoh konfigurasi environment
# Copy ke `.env.local` lalu sesuaikan. JANGAN commit file .env.local.
# ---------------------------------------------------------------------------

VITE_APP_NAME="Integrator PDDikti"

# Base URL aplikasi SIAKAD (backend yang menyediakan endpoint /api/integrator/*)
VITE_SIAKAD_API_URL="https://sia.example.ac.id"

# Prefix endpoint integrator pada backend SIAKAD
VITE_INTEGRATOR_API_PREFIX="/api/integrator"

# ---------------------------------------------------------------------------
# MOCK MODE
# true  -> seluruh request dilayani mock adapter di browser (tanpa backend,
#          tanpa Neo Feeder). Dipakai untuk pengembangan UI & demo.
# false -> request dikirim ke VITE_SIAKAD_API_URL secara nyata.
# ---------------------------------------------------------------------------
VITE_MOCK_MODE="true"

# Simulasi latensi mock (ms) — membantu menguji skeleton/loading state
VITE_MOCK_LATENCY_MS="320"

# ---------------------------------------------------------------------------
# CATATAN KEAMANAN
# ---------------------------------------------------------------------------
# JANGAN pernah menaruh kredensial Neo Feeder / token di environment frontend.
# Username, password, dan token Neo Feeder WAJIB disimpan di backend dan hanya
# dikirim ke Neo Feeder oleh backend. Frontend hanya menerima status koneksi.
#
# VITE_NEOFEEDER_BASE_URL TIDAK dipakai frontend (didokumentasikan di
# src/config/app.config.ts sebagai referensi operator saja).
